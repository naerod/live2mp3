# Clé DeepSeek — jamais committée. Copier ce fichier en .env et remplir.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Whisper local par défaut
WHISPER_MODE=local
WHISPER_MODEL=large-v3

# Redis (jobs RQ)
REDIS_URL=redis://redis:6379/0

# Source protégée (optionnel)
# YTDLP_COOKIES=/config/cookies.txt
