# Clé DeepSeek — jamais committée. Copier ce fichier en .env et remplir.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Whisper local par défaut
WHISPER_MODE=local
WHISPER_MODEL=large-v3

# --- Environnement (prod / preprod) ---
# ENV_SUFFIX="" pour la prod ; "-preprod" pour la preprod
# (pilote les noms de conteneurs, images et volumes).
ENV_SUFFIX=
APP_ENV=prod
# GIT_COMMIT est injecté par les scripts de déploiement (sha court).
GIT_COMMIT=

# Source protégée (optionnel)
# YTDLP_COOKIES=/config/cookies.txt

# Rafraîchissement Jellyfin après re-rendu d'un album déjà publié (optionnel)
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_API_KEY=
